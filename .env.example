GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1

# Business configuration
BUSINESS_NAME=Your Business Name
BUSINESS_HOURS=Monday-Friday 9am-5pm
BUSINESS_PHONE=+1-555-000-0000
BUSINESS_EMAIL=info@yourbusiness.com
BUSINESS_ADDRESS=123 Business Address, City, State 00000

# Receptionist persona
RECEPTIONIST_NAME=Alex

# Cal.com integration
# API key from Cal.com Settings → Developer → API Keys
CALCOM_API_KEY=your_calcom_api_key_here
# Your Cal.com username (the part before the / in your event URL)
# CALCOM_USERNAME=your_calcom_username
CALCOM_USERNAME=your_calcom_username
# Event Type ID — found in the URL when editing an event type on Cal.com (e.g. cal.com/event-types/123 → 123)
CALCOM_EVENT_TYPE_ID=123
# Timezone for interpreting date/time inputs from callers
CALCOM_TIMEZONE=Asia/Kolkata
# Fallback email used when the caller does not provide one
CALCOM_FALLBACK_EMAIL=reception@yourbusiness.com

# Voice (Sarvam AI + Plivo/Twilio/Exotel)
SARVAM_API_KEY=your_sarvam_api_key_here
# Active provider for /call/* endpoints: "plivo" or "twilio" or "exotel"
VOICE_PROVIDER=plivo

# Plivo credentials (https://console.plivo.com) — used when VOICE_PROVIDER=plivo
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+1-555-000-0000

# Twilio credentials (https://console.twilio.com) — used when VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1-555-000-0000

# Exotel credentials (alternatively, for VOICE_PROVIDER=exotel)
EXOTEL_SID=your_exotel_sid
EXOTEL_SUBDOMAIN=your_exotel_subdomain
EXOTEL_TOKEN=your_exotel_token
EXOTEL_PHONE_NUMBER=+1-555-000-0000
EXOTEL_REGION=your_exotel_region

# DAILY_API_KEY for browser voice calls
DAILY_API_KEY=your_daily_api_key_here

# SQLite path for call logs / conversation history.
# On ephemeral platforms (Azure Container Apps, Modal, etc.) point this at a
# mounted persistent volume, or data is lost when the container restarts.
SQLITE_PATH=data/receptionist.db

# Domain for the Caddy reverse proxy (docker-compose.yml + Caddyfile), used
# when deploying to a plain VM via deploy-vm.sh. Leave unset for local/IP-only
# testing (plain HTTP on :80); set to a real domain pointed at the VM's public
# IP to get automatic HTTPS — required for Plivo/Twilio/Exotel wss:// streams.
DOMAIN=aevum-intel.com
